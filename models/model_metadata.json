{
  "project_name": "Crop Disease Detection App for Farmers (Kisan Drishti)",
  "author": "Khushi Yadav",
  "degree": "B.Tech Computer Science & Engineering",
  "model_architecture": "MobileNetV2 (Transfer Learning)",
  "base_weights": "ImageNet (Pretrained Feature Extractor)",
  "num_classes": 38,
  "input_shape": [1, 3, 224, 224],
  "training_hyperparameters": {
    "batch_size": 32,
    "epochs": 25,
    "initial_learning_rate": 0.0003,
    "lr_scheduler": "CosineAnnealingLR (T_max=25, eta_min=1e-6)",
    "optimizer": "AdamW (weight_decay=1e-4)",
    "loss_function": "CrossEntropyLoss(label_smoothing=0.1)",
    "early_stopping_patience": 5,
    "data_augmentation": [
      "RandomHorizontalFlip(p=0.5)",
      "RandomVerticalFlip(p=0.2)",
      "RandomRotation(degrees=20)",
      "ColorJitter(brightness=0.15, contrast=0.15, saturation=0.15)",
      "RandomAffine(degrees=0, translate=(0.08, 0.08))"
    ]
  },
  "evaluation_metrics": {
    "test_accuracy": 0.9842,
    "macro_precision": 0.9815,
    "macro_recall": 0.9831,
    "macro_f1_score": 0.9823,
    "top_3_accuracy": 0.9982,
    "inference_latency_cpu_ms": 28.4,
    "model_size_mb": 8.7
  }
}
